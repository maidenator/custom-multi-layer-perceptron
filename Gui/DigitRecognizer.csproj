<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Backpropagation</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../NeuralNetwork.cs" Link="Model/NeuralNetwork.cs" />
    <Compile Include="../InputNeuron.cs" Link="Model/InputNeuron.cs" />
    <Compile Include="../HiddenNeuron.cs" Link="Model/HiddenNeuron.cs" />
    <Compile Include="../OutputNeuron.cs" Link="Model/OutputNeuron.cs" />
    <Compile Include="../DigitNormalizer.cs" Link="Model/DigitNormalizer.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../weights/epoch-5.txt" Link="weights/epoch-5.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
